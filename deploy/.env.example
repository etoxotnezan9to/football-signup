# Копируется в /opt/football/<env>/.env, права 600. Значения подставляет владелец на сервере, в репозиторий не попадают.
NODE_ENV=production
VK_APP_ID=54809461
# «Защищённый ключ» из настроек приложения VK: Разработка → Ключи доступа
VK_APP_SECRET=
# «Сервисный ключ доступа» из тех же настроек. Нужен только для личных уведомлений; пусто — уведомления выключены
VK_SERVICE_KEY=
# Часовой пояс времени игры в тексте уведомлений (IANA)
NOTIFY_TIMEZONE=Europe/Moscow
DATABASE_FILE=/data/football.db
# Тестовый режим (только staging): организатор может добавлять в игру тестовых игроков
TEST_MODE=
# На prod впишите 1: тогда TEST_MODE=1 там не запустится
TEST_MODE_FORBIDDEN=
# Параметры развёртывания (читает docker compose и deploy/release.sh, приложению не нужны)
API_PORT=
GHCR_OWNER=
