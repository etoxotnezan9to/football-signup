# Копируется в /opt/football/<env>/.env, права 600. Значения подставляет владелец на сервере, в репозиторий не попадают.
NODE_ENV=production
VK_APP_ID=54809461
# «Защищённый ключ» из настроек приложения VK: Разработка → Ключи доступа
VK_APP_SECRET=
DATABASE_FILE=/data/football.db
# Параметры развёртывания (читает docker compose и deploy/release.sh, приложению не нужны)
API_PORT=
GHCR_OWNER=
